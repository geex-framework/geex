{
  "name": "@geexcode/geex-extensions-approval-flows",
  "version": "0.0.1",
  "description": "Approval flows extension tokens for Geex Angular apps. Aligns with Geex.Extensions.ApprovalFlows.",
  "sideEffects": false,
  "peerDependencies": {
    "@angular/core": "^20.0.0",
    "@geexcode/geex-angular": ">=0.0.41"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "files": ["dist"],
  "module": "dist/fesm2022/geexcode-geex-extensions-approval-flows.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    "./package.json": { "default": "./package.json" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fesm2022/geexcode-geex-extensions-approval-flows.mjs",
      "default": "./dist/fesm2022/geexcode-geex-extensions-approval-flows.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "node --test src/provide-geex-approval-flows.node-test.mjs",
    "prepublishOnly": "npm run build",
    "publish:public": "npm publish ./dist --access public"
  },
  "devDependencies": {
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@geexcode/geex-angular": "workspace:*",
    "ng-packagr": "^20.0.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.8.3"
  }
}
