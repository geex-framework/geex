{
  "$schema": "http://json-schema.org/schema",
  "$id": "GeexSyncModule",
  "title": "Sync Geex UI Module",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Module short name. Omit when using --all.",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "path": {
      "type": "string",
      "default": "src/app/modules"
    },
    "all": {
      "type": "boolean",
      "default": false,
      "description": "Sync every module recorded in .geex/modules.json"
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Overwrite existing files"
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "visible": false,
      "description": "Internal CLI alias for force"
    }
  }
}
